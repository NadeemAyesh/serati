# ===================================================
# منصة سيرتي (Seerati) - المتغيرات البيئية للتشغيل والرفع
# ===================================================

# المنفذ الافتراضي (سيتحدد تلقائياً في السيرفرات السحابية)
PORT=5000

# رابط قاعدة بيانات MongoDB (محلياً أو رابط Atlas السحابي)
MONGODB_URI=mongodb://127.0.0.1:27017/seerati_cv_db
# مثال لرابط سحابي على MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster0.abcde.mongodb.net/seerati_cv_db?retryWrites=true&w=majority

# المفتاح السري لتشفير الجلسات وحسابات المستخدمين (JWT)
JWT_SECRET=seerati_super_secret_production_key_2026_xyz

# بيئة التشغيل (development أو production)
NODE_ENV=production

# مفتاح Google Gemini API لتشغيل ميزات الذكاء الاصطناعي (اختياري)
GEMINI_API_KEY=
